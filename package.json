{
  "name": "paw",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Zero-config warm claude-code agents on the cotal mesh — one agent per folder, addressable, persistent.",
  "bin": {
    "paw": "./bin/paw.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check:addressing": "node scripts/check-addressing.ts",
    "check:web": "node scripts/check-web.ts",
    "check:transcript": "node scripts/check-transcript.ts",
    "check:adopt": "node scripts/check-adopt.ts",
    "check:chat": "node scripts/check-chat.ts",
    "check:commands": "node scripts/check-commands.ts",
    "check:concurrency": "node scripts/check-concurrency.ts",
    "check:dispatch": "node scripts/check-dispatch.ts",
    "check:foreground": "node scripts/check-foreground.ts",
    "check:github": "node scripts/check-github.ts",
    "check:images": "node scripts/check-images.ts",
    "check:launch": "node scripts/check-launch.ts",
    "check:log": "node scripts/check-log.ts",
    "check:loop": "node scripts/check-loop.ts",
    "check:markdown": "node scripts/check-markdown.ts",
    "check:paste": "node scripts/check-paste.ts",
    "check:rail": "node scripts/check-rail.ts",
    "check:rename": "node scripts/check-rename.ts",
    "check:rm": "node scripts/check-rm.ts",
    "check:spawn-env": "node scripts/check-spawn-env.ts",
    "check:status": "node scripts/check-status.ts",
    "check:stdout": "node scripts/check-stdout.ts",
    "check:url": "node scripts/check-url.ts",
    "check:worktree": "node scripts/check-worktree.ts",
    "paw": "node bin/paw.ts",
    "plugin:build": "tsc -p plugin/tsconfig.json && node plugin/scripts/stamp-root.mjs",
    "plugin:install": "pnpm plugin:build && cotal ext add ./plugin",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:mcp": "node scripts/check-mcp.ts",
    "check:bash-tty": "node scripts/check-bash-tty.ts",
    "check:top": "node scripts/check-top.ts",
    "check:sleep": "node scripts/check-sleep.ts",
    "check:hub": "node scripts/check-hub.ts",
    "check:trust": "node scripts/check-trust.ts"
  },
  "dependencies": {
    "@cotal-ai/cli": "0.66.1",
    "@cotal-ai/cmux": "0.66.1",
    "@cotal-ai/connector-claude-code": "0.66.1",
    "@cotal-ai/connector-codex": "0.66.1",
    "@cotal-ai/connector-opencode": "0.66.1",
    "@cotal-ai/core": "0.66.1",
    "@cotal-ai/manager": "0.66.1",
    "@cotal-ai/tmux": "0.66.1",
    "@cotal-ai/workspace": "0.66.1",
    "@nats-io/jetstream": "^3.4.0",
    "@nats-io/transport-node": "^3.4.0"
  },
  "devDependencies": {
    "@lydell/node-pty": "1.2.0-beta.12",
    "@types/node": "22.19.19",
    "tsx": "4.22.4",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.1.2",
  "license": "Apache-2.0"
}
